# Copy to .env and fill in. Never commit .env.
JWT_SECRET=change-me-to-a-long-random-string
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IMEI_ENCRYPTION_KEY=change-me-fernet-key
# Any long random string, different from the others:
IMEI_HMAC_KEY=change-me-another-long-random-string
# Local PostgreSQL (recommended):
DATABASE_URL=postgresql+psycopg://tracelink:devpass@localhost:5432/tracelink
# Zero-setup alternative for quick experiments:
# DATABASE_URL=sqlite:///./tracelink.db
ACCESS_TOKEN_MINUTES=30
# true = ownership codes are returned by the API (simulated phone channel, labelled "demo").
DEMO_MODE=false
